# Copiá este archivo a .env.local y completá los valores. Nunca subas valores reales.
# Ninguna de estas variables lleva el prefijo NEXT_PUBLIC_: son solo del servidor.

# Token personal de Airtable (scopes: data.records:read, data.records:write; acceso a la base).
AIRTABLE_TOKEN=

# ID de la base de Airtable (empieza con "app").
AIRTABLE_BASE_ID=

# Secreto para firmar sesiones. Generalo con: openssl rand -base64 32
SESSION_SECRET=

# SOLO LOCAL (nunca en Vercel): contraseña inicial del primer Admin para `npm run bootstrap:admin`.
BOOTSTRAP_ADMIN_PASSWORD=

# Sincronización con ARCA (CC-F5-03): token de la API de Afip SDK. Opcional: sin él, la app
# funciona igual y «Sincronizar con ARCA» queda deshabilitado. Va en Vercel (Production).
AFIP_SDK_TOKEN=

# SOLO DEV (next dev, smoke test con un stub local): base URL alternativa de Afip SDK.
# Solo se usa con NODE_ENV=development y solo http://localhost o http://127.0.0.1.
# AFIP_SDK_BASE_URL=http://localhost:4010/api/v1
