# Copiá este archivo a .env.local y completá los valores. Nunca subas valores reales.
# Ninguna de estas variables lleva el prefijo NEXT_PUBLIC_: son solo del servidor.

# Token personal de Airtable (scopes: data.records:read, data.records:write; acceso a la base).
AIRTABLE_TOKEN=

# ID de la base de Airtable (empieza con "app").
AIRTABLE_BASE_ID=

# Secreto para firmar sesiones. Generalo con: openssl rand -base64 32
SESSION_SECRET=
